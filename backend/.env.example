# Ładowanie lokalne: uv run --project backend --env-file backend/.env uvicorn --app-dir backend main:app
# Compose: docker compose --env-file backend/.env up --build backend
# Bez RISK_MINER_TOKENS tryb demonstracyjny używa tokenów opisanych w docs/implementation/backend.md.
# RISK_MINER_TOKENS='{"wstaw-losowy-token":{"id":"operator-1","roles":["operator","analyst","expert"]}}'
# RISK_MINER_DB_PATH=data/risk-miner.db
RISK_MINER_OFFLINE=1
RISK_MINER_MAX_FILE_BYTES=10485760
RISK_MINER_MONITOR_SECONDS=3600
RISK_MINER_BZP_URL=https://ezamowienia.gov.pl
RISK_MINER_TED_URL=https://api.ted.europa.eu/v3/notices/search
# Ustaw 1 w celu wyszukiwania po publicznym tytule i zamawiającym. Numer TED działa niezależnie.
RISK_MINER_TED_CONTEXT=0

# Domyślnie ekstrakcja i analiza lokalna. Opcjonalny adres zgodny z Chat Completions, np. lokalny serwer.
RISK_MINER_MODEL_URL=
RISK_MINER_MODEL=
RISK_MINER_MODEL_KEY=
# W wdrożeniu udokumentuj region faktycznego przetwarzania i licencję wybranego modelu.
# Przykładowy region przy wyłączonym modelu: lokalnie, na urządzeniu operatora.
