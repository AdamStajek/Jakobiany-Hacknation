{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Field analysis 1.0",
  "type": "object",
  "required": [
    "schema_version",
    "field_id",
    "analysis_date",
    "crop_context",
    "data_quality",
    "water_balance",
    "soil_water_availability",
    "retention_potential",
    "historical_analysis",
    "modelled_soil_profile",
    "water_status",
    "root_cause_analysis",
    "scenario_analysis",
    "satellite_context",
    "irrigation_recommendations",
    "prioritized_action_plan",
    "missing_data",
    "calculation_trace",
    "methods",
    "uncertainty",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "field_id": {
      "type": "string"
    },
    "analysis_date": {
      "type": "string",
      "format": "date"
    },
    "crop_context": {
      "type": "object"
    },
    "water_balance": {
      "type": "object"
    },
    "soil_water_availability": {
      "type": "object"
    },
    "retention_potential": {
      "type": "object"
    },
    "historical_analysis": {
      "type": "object"
    },
    "modelled_soil_profile": {
      "type": "object"
    },
    "water_status": {
      "type": "string"
    },
    "root_cause_analysis": {
      "type": "array"
    },
    "scenario_analysis": {
      "type": "object"
    },
    "satellite_context": {
      "type": "object"
    },
    "irrigation_recommendations": {
      "type": "object"
    },
    "prioritized_action_plan": {
      "type": "array"
    },
    "missing_data": {
      "type": "object"
    },
    "calculation_trace": {
      "type": "object"
    },
    "methods": {
      "type": "object"
    },
    "uncertainty": {
      "type": "string"
    },
    "limitations": {
      "type": "array"
    },
    "data_quality": {
      "type": "object"
    },
    "farmer_report": {
      "type": "object",
      "required": [
        "situation",
        "next_check",
        "steps"
      ],
      "properties": {
        "situation": {
          "type": "string"
        },
        "next_check": {
          "type": [
            "string",
            "null"
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "when",
              "action",
              "why"
            ],
            "properties": {
              "when": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "why": {
                "type": "string"
              },
              "area_impact": {
                "type": "string",
                "description": "Wpływ działania na powierzchnię dostępną pod uprawę"
              },
              "condition": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
